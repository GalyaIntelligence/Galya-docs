{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Galya API",
  "theme": "mint",
  "seo": {
    "metatags": {
      "canonical": "https://galya.io/docs"
    }
  },
  "colors": {
    "primary": "#0D9373",
    "light": "#55D799",
    "dark": "#0D9373"
  },
  "favicon": "/favicon.png",
  "api": {
    "playground": {
      "display": "interactive"
    },
    "url": "full",
    "mdx": {
      "server": "https://api.galya.io",
      "auth": {
        "method": "key",
        "name": "X-API-Key"
      }
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": ["introduction", "quickstart", "authentication", "dashboard"]
          },
          {
            "group": "Concepts",
            "pages": ["concepts/readouts"]
          },
          {
            "group": "Catalog",
            "pages": ["guides/items", "guides/schemas", "guides/schema-library"]
          },
          {
            "group": "Shoppers",
            "pages": ["guides/users"]
          },
          {
            "group": "Ranking shortcuts",
            "pages": ["guides/search", "guides/rerank", "guides/recommend"]
          },
          {
            "group": "Agents and sources",
            "pages": ["guides/agentic-search", "guides/connectors"]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "/openapi/openapi.yaml"
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://app.galya.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Request access",
      "href": "https://www.galya.io/pilot/"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/GalyaIntelligence"
    }
  }
}
