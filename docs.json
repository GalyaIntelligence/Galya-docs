{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Galya API",
  "theme": "mint",
  "seo": {
    "metatags": {
      "canonical": "https://galya.io/docs"
    }
  },
  "colors": {
    "primary": "#0D9373",
    "light": "#55D799",
    "dark": "#0D9373"
  },
  "favicon": "/favicon.svg",
  "api": {
    "playground": {
      "display": "interactive"
    },
    "url": "full",
    "mdx": {
      "server": "https://dev.api.galya.io",
      "auth": {
        "method": "key",
        "name": "X-API-Key"
      }
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "dashboard",
              "authentication",
              "quickstart",
              "development-api"
            ]
          },
          {
            "group": "Catalog",
            "pages": [
              "concepts/catalog-and-taste",
              "guides/entities",
              "guides/index",
              "guides/link"
            ]
          },
          {
            "group": "Query",
            "pages": ["guides/search", "guides/recommend", "guides/rerank", "guides/models"]
          },
          {
            "group": "Agents and sources",
            "pages": ["guides/agentic-search", "guides/connectors", "guides/audience-types"]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "/openapi/openapi.yaml"
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://app.galya.io"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/GalyaIntelligence"
    }
  }
}
